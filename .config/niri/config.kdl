// niri 配置（KDL 格式：https://kdl.dev）
// 节点前加 "/-" 表示注释掉。完整选项见 wiki：
// https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
config-notification {
    disable-failed
}

// 关掉屏幕四角的热区（DMS 自己处理边缘手势）
gestures {
    hot-corners {
        off
    }
}

// 输入设备。完整选项见 wiki：Configuration:-Input
input {
    keyboard {
        xkb {
            // 可写 rules / model / layout / variant / options，取值见 xkeyboard-config(7)。
            // 例如：
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"

            // 留空时由 niri 从 org.freedesktop.locale1 读取，
            // 即 localectl set-x11-keymap 写下的值。
        }

        // 启动时打开数字键盘锁；删掉这行则关闭。
        numlock
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // 取消注释：新获得焦点的窗口把鼠标吸到中心。
    // warp-mouse-to-focus

    // 鼠标移入即聚焦。max-scroll-amount="0%" 只对已完全在屏内的窗口生效。
    // focus-follows-mouse max-scroll-amount="0%"
}

// 输出按名字配置，名字用 `niri msg outputs` 查，内屏通常叫 "eDP-1"。
// 完整选项见 wiki：Configuration:-Outputs。解除注释时别忘了去掉 "/-"。
/-output "eDP-2" {
    mode "2560x1600@239.998993"
    position x=2560 y=0
    variable-refresh-rate
}
// 窗口如何摆放、定尺寸。完整选项见 wiki：Configuration:-Layout
layout {
    // 布局底色，透明表示露出 DMS 的壁纸层。
    background-color "transparent"
    // 切换焦点时列何时居中：
    // - "never"（默认）：聚焦屏外的列时贴到屏幕左右边缘；
    // - "always"：聚焦的列总是居中；
    // - "on-overflow"：和上一个聚焦列并排放不下时才居中。
    center-focused-column "never"
    // "switch-preset-column-width"（Mod+R）在哪些宽度间切换。
    preset-column-widths {
        // proportion 按输出宽度的比例算（已计入间隙），0.25 正好并排四个。
        // 默认预设是 1/3、1/2、2/3。
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        // fixed 是写死的逻辑像素宽度。
        // fixed 1920
    }
    // "switch-preset-window-height"（Mod+Shift+R）的高度预设同理。
    // preset-window-heights { }
    // 新窗口的默认宽度。
    default-column-width { proportion 0.5; }
    // 括号留空则由窗口自己决定初始宽度。
    // default-column-width {}
    // 默认焦点环和边框画在窗口后面的一整块矩形上，半透明窗口里会透出来，
    // 因为客户端自绘装饰的窗口可以是任意形状。
    // 想画在窗口外围，取消下面 prefer-no-csd 的注释；
    // 也可以用窗口规则 draw-border-with-background 单独覆盖。
    border {
        off
        width 4
        active-color   "#707070"      // 中性灰
        inactive-color "#d0d0d0"      // 浅灰
        urgent-color   "#cc4444"      // 偏柔和的红
    }
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    struts {
    }
}
// DMS 的 quickshell 图层放进背景层，不盖住窗口
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}
// 概览里的工作区不加阴影
overview {
    workspace-shadow {
        off
    }
}
// 会话环境：让 GTK / Qt / SDL 程序都走 fcitx5，并声明桌面类型。
// niri 作为会话运行时也支持 xdg-desktop-autostart，开机自启两边都行。
environment {
  XDG_CURRENT_DESKTOP "niri"
  XMODIFIERS "@im=fcitx"
  GTK_IM_MODULE "fcitx"
  QT_IM_MODULE "fcitx"
  SDL_IM_MODULE "fcitx"
}
// 输入法守护进程
spawn-at-startup "fcitx5" "-d"
// 启动时不弹快捷键提示
hotkey-overlay {
    skip-at-startup
}
// 让窗口不用客户端装饰，边框由 niri 画（见上面 border 的说明）
prefer-no-csd
// 截图保存路径（niri 自带截图，Print 键）
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
// 动画手感：spring 给弹簧参数，duration-ms + curve 给固定时长
animations {
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}
// 窗口规则：按 app-id / title 单独调行为。完整选项见 wiki：Configuration:-Window-Rules

// WezTerm 首次 configure 有 bug，拿空的 default-column-width 绕开；
// 正则写严是怕误伤，只匹配 wezterm 的话 app-id="wezterm" 就够。
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
// GNOME 系（文件选择器、设置等）用客户端装饰：给圆角并裁掉窗框
window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}
// 设置、网络连接编辑器等对话框：半屏宽，不浮起
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}
// 计算器、蓝牙管理器、portal 对话框：浮起
window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^xdg-desktop-portal$"#
    open-floating true
}
// Steam 的通知 toast：贴右下角，不抢焦点
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
// 终端与浏览器自己画边框，不要背景框，免得半透明时出现双层框
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}
// 画中画、Zoom 会议窗口：浮起
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}
// 旧 Electron 客户端的 xdg-activation serial 不合法，放行它们才能被跳转激活
debug {
    honor-xdg-activation-with-invalid-serial
}

// 最近窗口列表：Alt+Tab / Alt+`，把 Mod+Tab 空出来；
// 后两个按 app-id 过滤，只在同一应用的不同窗口间切换。
recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

// 输入法切换：Win+Space。fcitx 自己也绑了 Super+space（见 .config/fcitx5/config），
// 两层都配：compositor 这层保证全局生效，输入法那层在按键没被 niri 截走时兜底。
binds {
    Mod+Space hotkey-overlay-title="Toggle Input Method" { spawn "fcitx5-remote" "-t"; }
}

// DMS 生成的片段（颜色、布局、Alt-Tab、按键、输出、光标、输入），会随界面设置重写
include optional=true "dms/colors.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/alttab.kdl"
include optional=true "dms/binds.kdl"
include optional=true "dms/outputs.kdl"
include optional=true "dms/cursor.kdl"
include optional=true "dms/input.kdl"
